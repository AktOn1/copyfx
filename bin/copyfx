#!/usr/bin/env python3
"""CopyFX command line (developer tool).

  copyfx materialise SRC TARGET    copy the plugin's code, effects and posters to a fresh runtime tree (used by the dev reload, see tests/dev-reload.sh)
"""
import json, os, shutil, sys


def die(msg, code=1):
    print("copyfx: " + msg, file=sys.stderr)
    sys.exit(code)


def cmd_materialise(args):
    """SRC TARGET: copy the plugin's code, effects and posters to a fresh runtime tree (the dev reload plays effects from there)."""
    if len(args) != 2:
        die("usage: copyfx materialise SRC TARGET")
    src, target = args
    shutil.rmtree(target, ignore_errors=True)
    os.makedirs(target)
    for item in os.listdir(src):
        p = os.path.join(src, item)
        if item.endswith((".qml", ".js", ".json")) or item in ("effects", "posters"):
            (shutil.copytree if os.path.isdir(p) else shutil.copy2)(p, os.path.join(target, item))
    parent = os.path.dirname(target)                               # keep the newest few trees (the shell may still hold the previous one)
    olds = sorted([os.path.join(parent, d) for d in os.listdir(parent) if d.startswith("v")], key=os.path.getmtime, reverse=True)
    for d in olds[4:]:
        shutil.rmtree(d, ignore_errors=True)
    print(json.dumps({"built": True}))


def main(argv):
    if len(argv) >= 1 and argv[0] == "materialise":
        return cmd_materialise(argv[1:])
    print(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
